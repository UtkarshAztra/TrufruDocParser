# TruFru Doc Parser - environment template
#
# Copy this file to .env and fill in the values:   cp .env.example .env
# .env is gitignored and is loaded automatically by pdf_parser, agent_server and
# scripts/start_app.py. Only the keys below are read by this project.
# Lines marked (required) must be set; everything else has a sensible default.


# =============================================================================
# 1. Databricks authentication  (pdf_parser/config.py -> get_client)
# =============================================================================
# The PDF parser talks to Databricks to upload PDFs to a Unity Catalog Volume
# and run ai_parse_document on a SQL warehouse. Two auth options; set at least one.

# Option A - Personal Access Token (used first when both HOST and TOKEN are set).
# Host is the workspace URL; the "https://" prefix is optional and added if missing.
# DATABRICKS_HOST=adb-xxxxxxxxxxxxxxxx.xx.azuredatabricks.net
# DATABRICKS_TOKEN=dapi...

# Option B - Databricks CLI profile (fallback when the PAT is missing or rejected).
# Create it with:  databricks auth login --profile DEFAULT
# Also the profile every `databricks` CLI / bundle command in this repo must use.
DATABRICKS_CONFIG_PROFILE=DEFAULT


# =============================================================================
# 2. PDF parser  (pdf_parser/*, run with: uv run python -m pdf_parser <file.pdf>)
# =============================================================================

# (required) SQL warehouse that executes ai_parse_document. Must be a Pro or
# Serverless warehouse with AI Functions enabled. Find the ID in the warehouse
# URL: .../sql/warehouses/<DATABRICKS_WAREHOUSE_ID>
DATABRICKS_WAREHOUSE_ID=

# (required) Unity Catalog Volume where PDFs are uploaded before parsing.
# Files land under <volume>/pdf_parser/<run_id>/batch_<n>/<file>.pdf
# The token/profile above needs READ VOLUME + WRITE VOLUME on it.
TRUFRU_PARSER_VOLUME=/Volumes/<catalog>/<schema>/<volume>

# (optional) ai_parse_document version to request. Defaults to 2.0.
# TRUFRU_PARSER_VERSION=2.0


# =============================================================================
# 3. Packet parser / fuzzy matcher  (packet_parser/fuzzy_matcher/config.py)
# =============================================================================

# (optional) Folder holding the master data CSVs used to confirm products,
# lots and keywords: master_keywords.csv, master_products.csv, master_lots.csv.
# Defaults to docs/official-docs in the project root (gitignored, so each
# developer needs a local copy). Can also be passed as --master-dir on the CLI.
# TRUFRU_MASTER_DIR=docs/official-docs


# =============================================================================
# 4. Agent server / Databricks App scaffold  (agent_server/*, scripts/start_app.py)
# =============================================================================
# Only needed when running `uv run start-app` locally or deploying the app
# with `databricks bundle deploy`. The parsers above do not use these.

# MLflow experiment that receives agent traces. Create one with
# `uv run quickstart` or `databricks experiments create-experiment`, then paste
# the numeric ID. Also set experiment_id in databricks.yml for deployment.
MLFLOW_EXPERIMENT_ID=

# Where MLflow sends traces / looks up models. Keep the defaults for Databricks.
# quickstart may rewrite the tracking URI to "databricks://<profile>".
MLFLOW_TRACKING_URI="databricks"
MLFLOW_REGISTRY_URI="databricks-uc"

# Local chat UI port (the FastAPI agent backend uses 8000) and how long the
# UI proxy waits for a backend response before timing out.
CHAT_APP_PORT=3000
CHAT_PROXY_TIMEOUT_SECONDS=300
